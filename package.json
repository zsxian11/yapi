    "reactabular-dnd": "^8.16.0",
    "reactabular-table": "^8.14.0",
    "recharts": "^2.15.4",
    "redux": "^4.2.1",
    "sass": "^1.101.0",
    "table-resolver": "^4.1.1",
    "vite": "^6.4.3",
    "vite-plugin-commonjs": "^0.10.4",
